{
  "name": "cypress-api-web-tests",
  "version": "1.0.0",
  "description": "\"Testes automatizados de api e web\"",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "typecheck": "tsc --noEmit",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.ts\"",
    "test:web": "cypress run --spec \"cypress/e2e/web/**/*.feature\"",
    "test": "cypress run"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/**/steps/**/*.{js,ts}"
    ]
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@types/node": "^26.6.5",
    "cypress": "^16.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhaynner-costa/cypress-api-web-tests.git"
  },
  "author": "Rhaynner Costa",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rhaynner-costa/cypress-api-web-tests/issues"
  },
  "homepage": "https://github.com/rhaynner-costa/cypress-api-web-tests#readme"
}
